<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fanex.Caching.Redis" Version="2.2.8" />
    <PackageReference Include="Fanex.Common" Version="1.1.2.1" />
    <PackageReference Include="Fanex.Data.ProxyClient" Version="1.0.3.5" />
    <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.1.0" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
    <PackageReference Include="Fanex.MailDeliver.MailClient" Version="2.1.0" />
    <PackageReference Include="Fanex.NAP.Client" Version="2.0.3" />
    <PackageReference Include="Fanex.NAP.SignIn" Version="2.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.2" />
    <PackageReference Include="ONEbook.OTP" Version="2.1.0" />
    <PackageReference Include="ONEbook.UM" Version="3.2.4" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />
    <PackageReference Include="System.Linq.Async" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NapAdminCore\NapAdminCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="App_Data\SpNames.xml" />
    <Content Update="App_Data\SpNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>

    <Content Remove="wwwroot\scripts\User\assign-site-function\**" />
    <Content Include="wwwroot\scripts\User\assign-site-function\dist\css\main.css" />
    <AdditionalFiles Include="wwwroot\scripts\User\assign-site-function\dist\css\main.css.map" />
    <Content Include="wwwroot\scripts\User\assign-site-function\dist\main.js" />
    <AdditionalFiles Include="wwwroot\scripts\User\assign-site-function\dist\main.js.map" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="App_Data\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Include="Views\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
