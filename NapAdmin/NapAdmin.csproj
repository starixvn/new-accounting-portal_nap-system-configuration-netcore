<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    
    <Content Remove="wwwroot\scripts\User\assign-site-function\**" />
    <Content Include="wwwroot\scripts\User\assign-site-function\dist\css\main.css" />
    <AdditionalFiles Include="wwwroot\scripts\User\assign-site-function\dist\css\main.css.map" />
    <Content Include="wwwroot\scripts\User\assign-site-function\dist\main.js" />
    <AdditionalFiles Include="wwwroot\scripts\User\assign-site-function\dist\main.js.map" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="App_Data\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Include="Views\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>


  <ItemGroup>
    <None Remove="App_Data\SpNames.xml" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Fanex.Caching.Redis" Version="2.2.6" />
    <PackageReference Include="Fanex.Common" Version="1.1.2" />
    <PackageReference Include="Fanex.Data.ProxyClient" Version="1.0.1" />
    <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.1.0" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="1.1.0" />
    <PackageReference Include="Fanex.MailDeliver.MailClient" Version="2.0.11" />
    <PackageReference Include="Fanex.NAP.Client" Version="2.0.2" />
    <PackageReference Include="Fanex.NAP.SignIn" Version="2.0.2.2" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="8.0.8" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.8" />
    <PackageReference Include="ONEbook.OTP" Version="2.0.0" />
    <PackageReference Include="ONEbook.UM" Version="3.1.6" />
    <PackageReference Include="ONEbook.UM.AspNetCore" Version="3.1.1.1" />
    <PackageReference Include="ONEbook.UM.AspNetCore.Filters" Version="3.1.1.1" />
    <PackageReference Include="ONEbook.UM.Transport" Version="3.1.2" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="System.Linq.Async" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NapAdminCore\NapAdminCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="App_Data\SpNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
