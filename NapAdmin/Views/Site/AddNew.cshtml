@model InsertSiteCriteria
@{
    ViewBag.Title = ViewResources.Create_New_Site;
    bool success = ViewBag.Success != null && ViewBag.Success;
    var viewFlags = (ViewBag.ViewFlags ?? new ViewFlags { IsLive = false }) as ViewFlags;
}
@section Head {
    @Styles.Render("~/Areas/UserControl/themes/Site/AddNew")
}
@section Headline {
    <span class="title">
		<span class="first">@ViewResources.Site @ViewResources.Management /</span> @ViewBag.Title
    </span>
    <div class="button-action">
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Site", null, new { @class = "back-button" })
    </div>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-sm-7 col-md-5 common-form" }))
{
    <div class="form-group">
        @Html.ValidationSummary()
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.SiteName)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(m => m.SiteName, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.Description)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.Urls)
        </div>
        <div class="col-xs-12 col-sm-8 urls">
            <table>
                <thead>
                    <tr>
                        <th>
                        </th>
                        <th>
                            @ViewResources.Active
                        </th>
                        <th>
                            @ViewResources.Default
                        </th>
                        <th>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = Model.Urls.Count - 1; i >= 0; --i)
                    {
                        <tr>
                            <td class="text-center first">
                                @Html.TextBoxFor(m => m.Urls[i].Url, new { idx = i, id = string.Empty, @class = "form-control" })
                            </td>
                            <td class="text-center">
                                @Html.CheckBoxFor(m => m.Urls[i].IsActive, new { id = string.Empty })
                            </td>
                            <td class="text-center">
                                <input type="radio" value="Urls[@i].IsDefault" name="Urls" 
                                @(Model.Urls[i].IsDefault ? "checked=checked" : string.Empty) />
                            </td>
                            @if (i == 0)
                            {
                                <td class="text-center">
                                    <a href="javascript:;" class="btn-add-url" title="@ViewResources.Add_alternative_URL">
                                    </a>
                                </td>
                            }
                            else
                            {
                                <td class="text-center">
                                    <a href="javascript:;" class="btn-remove-url" title="@ViewResources.Remove" style="display: inline">
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <a href="javascript:;" class="btn-remove-url" title="@ViewResources.Remove"></a>
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.IsActive)
        </div>
        <div class="col-xs-12 col-sm-8 chk-field">
            @Html.CheckBoxFor(m => m.IsActive, new { @class = "chkActive" })
            @Html.LabelFor(m => m.IsActive, ViewResources.Active, new { @class = "lbActive" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3">
        </div>
        <div class="col-xs-12 col-sm-8">
            @if (!success)
            {
                <input type="submit" value="@ViewResources.Save" />
                <button class="cancel-button" onclick="NAP.redirect('Site/Manage', 0); return false;">@ViewResources.Cancel</button>
            }
        </div>
    </div>	
}
@section Foot {
    <script src="~/Areas/UserControl/scripts/Site/AddNew.js" type="text/javascript"></script>
    @if (success)
    {
        string dialogMsg = string.Format(ViewResources.AddSuccessMsg, ViewResources.Site + " '" + Model.SiteName + "'", 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'Site/Manage', 4000);
            });
        </script>
    }
}