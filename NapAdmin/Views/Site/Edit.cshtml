@model UpdateSiteCriteria
@{
    ViewBag.Title = ViewResources.Update_Site;
    bool success = ViewBag.Success != null && ViewBag.Success;
    var viewFlags = (ViewBag.ViewFlags ?? new ViewFlags { IsLive = false }) as ViewFlags;
}
@section Head {
    @Styles.Render("~/Areas/UserControl/themes/EditSite")
}
@section Headline {
    <span class="title">
        <span class="first">@ViewResources.Site @ViewResources.Management /</span> @ViewBag.Title
    </span>
    <div class="button-action">
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Site", null, new { @class = "back-button" })
    </div>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-sm-6 col-md-4 common-form" }))
{
    @Html.HiddenFor(m => m.SiteId)
    <div class="form-group summary">
        @Html.ValidationSummary()
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.SiteName)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(m => m.SiteName, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.SiteKey, ViewResources.Site_Key)
        </div>
        <div class="col-xs-10 col-sm-8">
            @Html.TextBox("txtSiteKey", Model.SiteKey, new { disabled = "disabled", @class = "form-control" })
            @Html.HiddenFor(m => m.SiteKey)
        </div>
        <div class="col-xs-2 col-sm-1 lbl-field icon-edit">
            <a id="lbtn-edit-siteKey" href="javascript:;" class="btn-edit" title="@ViewResources.Edit @ViewResources.Site_Key">
            </a>
        </div>
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.SiteKey, ViewResources.Secret_Access_Key)
        </div>
        <div class="col-xs-10 col-sm-8">
            @Html.TextBox("txtAccessSecretKey", Model.SecretAccessKey, new { disabled = "disabled", @class = "form-control" })
            @Html.HiddenFor(m => m.SecretAccessKey)
        </div>
        <div class="col-xs-2 col-sm-1 lbl-field icon-edit">
            <a id="lbtn-edit-accessKey" href="javascript:;" class="btn-edit" title="@ViewResources.Edit @ViewResources.Secret_Access_Key">
            </a>
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.Description)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.IsActive)
        </div>
        <div class="col-xs-12 col-sm-8 chk-field">
            @Html.CheckBoxFor(m => m.IsActive, new { @class = "chkActive" })
            @Html.LabelFor(m => m.IsActive, ViewResources.Active)
        </div>
    </div>
    if (viewFlags.IsLive)
    {
        @Html.HiddenFor(m => m.Environment)
    }
    else
    {
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(m => m.Environment)
            </div>
            <div class="col-xs-12 col-sm-8 rdo-field">
                @Html.RadioButtonFor(m => m.Environment, "UAT", new { id = "Environment-UAT" })
                @Html.Label("Environment-UAT", ViewResources.UAT)
                @Html.RadioButtonFor(m => m.Environment, "LIVE", new { id = "Environment-LIVE" })
                @Html.Label("Environment-LIVE", ViewResources.LIVE)
            </div>
        </div>
    }
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
        </div>
        <div class="col-xs-12 col-sm-8">
            @if (!success)
            {
                <input type="submit" value="@ViewResources.Save" />
                <button class="cancel-button" onclick="NAP.redirect('Site/Manage', 0); return false;">@ViewResources.Cancel</button>
            }
        </div>
    </div>
}
@section Foot {
    <script src="~/Areas/UserControl/scripts/Site/Edit.js" type="text/javascript"></script>
    @if (success)
    {
        string dialogMsg = string.Format(ViewResources.EditSuccessMsg, Model.SiteName, 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'Site/Manage', 4000);
            });
        </script>
    }
}