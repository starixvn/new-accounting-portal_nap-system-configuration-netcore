@{
    ViewBag.Title = ViewResources.Update_URL;
    var siteUrlList = ViewBag.Urls as List<SiteUrl>;
    int siteUrlListCount = siteUrlList.Count;
    var viewFlags = (ViewFlags)ViewBag.ViewFlags;
}
@section Head {
    @Styles.Render("~/Areas/UserControl/themes/Site/EditUrl")
}
@section Headline {
    <span class="title">
        <span class="first">@ViewResources.Site @ViewResources.Management /</span>
        @string.Format("Update URL of '{0}'", ViewBag.SiteName)
    </span>
    <div class="button-action">
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Site", null, new { @class = "back-button" })
    </div>
}
<div class="form">
    <table class="grid no-scale">
        <thead>
            <tr>
                <th>
                    @ViewResources.Active
                </th>
                <th>
                    @ViewResources.URL
                </th>
                @if (viewFlags.HasEditRight)
                {
                    <th>
                        @ViewResources.Edit
                    </th>
                }
                <th>
                    @ViewResources.Default
                </th>
                <th>
                    Environment
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var siteUrl in siteUrlList)
            {
                if (viewFlags.HasEditRight)
                {
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" @(Html.Raw(siteUrl.IsActive ? "checked='checked'" : string.Empty))
                                   autocomplete="off" disabled="disabled" />
                        </td>
                        <td>
                            <input type="text" value="@siteUrl.Url" disabled="disabled" autocomplete="off" />
                        </td>
                        <td>
                            <a href="javascript:;" class="btn-edit"></a><a href="javascript:;" class="btn-apply" suid="@siteUrl.SiteUrlId">@ViewResources.Apply</a>
                            <a href="javascript:;" class="btn-cancel">@ViewResources.Cancel</a>
                        </td>
                        <td class="text-center">
                            @Html.RadioButton("Url-" + siteUrl.Environment, siteUrl.IsDefault, siteUrl.IsDefault,
                                new { id = string.Empty, suid = siteUrl.SiteUrlId })
                        </td>
                        <td class="text-center">
                            <span class="site-url-environment-text">@(string.IsNullOrEmpty(siteUrl.Environment) ? "UAT" : siteUrl.Environment)</span>
                            @RazorHelper.BuildSiteEnvironmentDropDownList(siteUrl.Environment, new Dictionary<string, object> { { "style", "display:none" } })
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" @(Html.Raw(siteUrl.IsActive ? "checked='checked'" : string.Empty)) disabled="disabled" />
                        </td>
                        <td>
                            <input type="text" value="@siteUrl.Url" disabled="disabled" />
                        </td>
                        <td class="text-center">
                            <input type="radio" @(Html.Raw(siteUrl.IsDefault ? "checked='checked'" : string.Empty)) disabled="disabled" />
                        </td>
                        <td class="text-center">
                            @(string.IsNullOrEmpty(siteUrl.Environment) ? "UAT" : siteUrl.Environment)
                        </td>
                    </tr>
                }
            }
            @if (viewFlags.HasEditRight)
            {
                <tr class="last">
                    <td class="text-center">
                        <input type="checkbox" id="chk-add-url" />
                    </td>
                    <td>
                        <input type="text" id="txt-add-url" />
                    </td>
                    <td>
                        @RazorHelper.BuildSiteEnvironmentDropDownList("UAT", new Dictionary<string, object> { { "id", "site-url-environment" } })
                    </td>
                    <td class="text-center" colspan="2">
                        <input type="submit" value="+ @ViewResources.Add @ViewResources.URL"
                               id="btn-add-url" sid="@ViewBag.SiteId" />
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
@section Foot {
    @if (viewFlags.HasEditRight)
    {
        <script src="~/Areas/UserControl/scripts/Site/EditUrl.js" type="text/javascript"></script>
    }
}