
@model InsertMenuItemCriteria
@{
    ViewBag.Title = ViewResources.Create_New_Menu_Item;
    var viewFlags = (ViewFlags)ViewBag.ViewFlags;
    bool success = ViewBag.Success != null && ViewBag.Success;
}
@section Head {
    <link type="text/css" rel="stylesheet" href="~/themes/nap/style.css" />
}
@section Headline {
    <span class="title">
        <span class="first">@ViewResources.Menu @ViewResources.Management /</span> @ViewBag.Title
    </span>
    <div class="button-action">
    @if (Model.SiteId == 0)
    { 
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Menu", null, new { @class = "back-button" })
    }
    else
    {
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Menu", new { siteId = Model.SiteId }, new { @class = "back-button" })
    }
    </div>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-sm-7 col-md-5 common-form" }))
{
    <div class="form-group">
        @Html.ValidationSummary()
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.MenuItemName)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(m => m.MenuItemName, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.SiteId)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.DropDownListFor(m => m.SiteId, (List<SelectListItem>)ViewBag.Site, new { @class = "form-control chzn-select" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.Description)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.Url)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(m => m.Url, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.IsActive)
        </div>
        <div class="col-xs-12 col-sm-8 chk-field">
            @Html.CheckBoxFor(m => m.IsActive, new {@class = "chkActive" })
            @Html.LabelFor(m => m.IsActive, ViewResources.Active)
        </div>
    </div>
        if (!viewFlags.IsLive)
        {
            <div class="form-group">
                <div class="col-xs-12 col-sm-3 lbl-field">
                    @Html.LabelFor(m => m.Environment)
                </div>
                <div class="col-xs-12 col-sm-8 rdo-field">
                    @Html.RadioButtonFor(m => m.Environment, "UAT", new { @id = "Environment-UAT", @class = "environment" })
                    @Html.Label("Environment-UAT", ViewResources.UAT)
                    @Html.RadioButtonFor(m => m.Environment, "LIVE", new { @id = "Environment-LIVE", @class = "environment" })
                    @Html.Label("Environment-LIVE", ViewResources.LIVE)
                </div>
            </div>
        }
        else
        {
            @Html.HiddenFor(m => m.Environment)
        }
         <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.ParentId)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.DropDownListFor(m => m.ParentId, (List<SelectListItem>)ViewBag.Parent, ViewResources.None, new { @class = "form-control chzn-select" })
            @Html.HiddenFor(m => m.ParentName)
        </div>
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.FunctionId)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.DropDownListFor(m => m.FunctionId, (List<SelectListItem>)ViewBag.Function, new { @class = "form-control chzn-select" })
        </div>
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.Policy)
        </div>
        <div class="col-xs-12 col-sm-8 rdo-field">
            @Html.RadioButtonFor(m => m.Policy, (int)AdminConstant.Policy.Read, new { @id = "Policy-Read", @name = "Policy" })
            @Html.Label("Policy-Read", ViewResources.Read)
            @Html.RadioButtonFor(m => m.Policy, (int)AdminConstant.Policy.Host, new { @id = "Policy-Host", @name = "Policy" })
            @Html.Label("Policy-Host", ViewResources.Host)
        </div>
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.DisplayOrder)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control numeric" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3"></div>
        <div class="col-xs-12 col-sm-8">
            @if (!success)
      {
                <input type="submit" value="@ViewResources.Save" />
                <button class="cancel-button" onclick="NAP.redirect('Menu/Manage?siteId=@Model.SiteId', 0); return false;">@ViewResources.Cancel</button>
      }
        </div>
    </div>
}
@section Foot {
    <script src="~/scripts/Menu/AddNewMenuItem.js" type="text/javascript"></script>
    <script src="~/scripts/lib/jquery.numeric-1.3.js" type="text/javascript"></script>
	<script src="~/scripts/lib/jsrender.js" type="text/javascript"></script>
    <script type="text/x-jsrender" id="DropdownListTpl">
        <option value="{{:id}}">{{:name}}</option>
    </script>
    @if (success)
    {
        var dialogMsg = string.Format(ViewResources.AddSuccessMsg, ViewResources.Menu_Item + " '" + Model.MenuItemName + "'", 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'Menu/Manage?siteId=@Model.SiteId', 4000);
            });
        </script>
    }
}