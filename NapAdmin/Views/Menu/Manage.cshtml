@model GetBySiteMenuItemCriteria
@{
    ViewBag.Title = ViewResources.Manage_Menu;

    var viewFlags = (ViewFlags)ViewBag.ViewFlags;
    var menuItemList = (List<IMenuItem>)ViewBag.MenuItemList;
}
@section Head {
    <link type="text/css" rel="stylesheet" href="~/themes/nap/style.css" />
}
@section Headline {
    <span class="title">
        <span class="first">
            @ViewResources.Menu @ViewResources.Management
            /
        </span> @ViewBag.Title
    </span>
    @if (viewFlags.HasEditRight)
    {
        <div class="button-action">
            @Html.ActionLink("+ " + ViewResources.Create_New + " " + ViewResources.Menu_Item,
    "AddNewMenuItem", "Menu", new { siteId = Model.SiteId }, new { @class = "add-button" })
        </div>
    }
}
@if (viewFlags.IsNapAdminSite)
{

    using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-inline col-sm-12 filter-form" }))
    {
        <div class="form-group">
            @Html.LabelFor(m => m.SiteId)
            @Html.DropDownListFor(m => m.SiteId, (List<SelectListItem>)ViewBag.Site)
            @Html.HiddenFor(m => m.Environment)
        </div>
        <div class="form-group">
            <input type="submit" value="Submit" />
        </div>
    }

    <div class="col-sm-12 grid-title grid-view-mode">
        <a href="javascript:;" class="tree-mode active tip" id="btnTreeView" title="@ViewResources.Tree_View">
            @ViewResources.Tree_View
        </a><a href="javascript:;" class="grid-mode tip" id="btnGridView" title="@ViewResources.Grid_View">
            @ViewResources.Grid_View
        </a>
    </div>
}
<table class="col-sm-12 grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th class="first">
                @ViewResources.Name
            </th>
            <th class="grid-mode-only" style="display: none">
                @ViewResources.Parent
            </th>
            <th>
                @ViewResources.URL
            </th>
            <th>
                @ViewResources.Function
            </th>
            <th>
                @ViewResources.Policy
            </th>
            <th class="cmd nbr nbl">
                @ViewResources.Order
            </th>
            <th>
                @ViewResources.Modified_Date
            </th>
            <th>
                @ViewResources.Modifier
            </th>
            @if (!viewFlags.IsLive)
            {
                <th>
                    @ViewResources.Environment
                </th>
            }
            <th class="cmd nbr">
                @ViewResources.Active
            </th>
            @if (viewFlags.HasEditRight)
            {
                <th class="cmd nbl last">
                    @ViewResources.Edit
                </th>
            }
        </tr>
    </thead>
    <tbody id="contentMenuItem">
        @{
            var i = 0;

            foreach (MenuItem item in menuItemList)
            {
                var rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";

                <tr @Html.Raw(rowCss)>
                    <td class="text-center">
                        @(i + 1)
                    </td>
                    <td>
                        @{ IndentChildMenuItem(item, menuItemList, 0); }
                    </td>
                    <td class="grid-mode-only" style="display: none">
                        @(item.Parent != null ? item.Parent.Name : string.Empty)
                    </td>
                    <td>
                        @item.Url
                    </td>
                    <td>
                        @item.Function.Name
                    </td>
                    <td class="text-center">
                        @if (item.Policy == (int)AdminConstant.Policy.Host)
                        {
                            <span class="crud-host">@ViewResources.Host</span>
                        }
                        else
                        {
                            <span class="crud-read">@ViewResources.Read</span>
                        }
                    </td>
                    <td class="text-right">
                        @item.DisplayOrder
                    </td>
                    <td class="text-center">
                        @item.ModifiedDate.ToFullDateString()
                    </td>
                    <td>
                        @(item.Modifier != null ? item.Modifier.Name : string.Empty)
                    </td>
                    @if (!viewFlags.IsLive)
                    {
                        <td class="text-center">
                            @item.Environment
                        </td>
                    }
                    <td class="text-center">
                        @if (viewFlags.HasEditRight)
                        {
                            var activateText = item.IsActive ? "Deactivate" : "Activate";

                            @Html.CheckBox(string.Format("chk-menu-item-{0}", item.Id), item.IsActive,
                new
                {
                miid = item.Id,
                miname = item.Name,
                title = string.Format("{0} '{1}'", activateText, item.Name)
                })
                        }
                        else if (item.IsActive)
                        {
                            <img src="~/themes/nap/img/blank.png" alt="" class="ico-tick" />
                        }
                    </td>
                    @if (viewFlags.HasEditRight)
                    {
                        <td>
                            @Html.ActionLink(".", "EditMenuItem", new { menuItemid = item.Id },
                new
                {
                @class = "btn-edit tip",
                title = string.Format("{0} '{1}'", ViewResources.Edit, item.Name)
                })
                        </td>
                    }
                </tr>
                i++;
            }

            if (i == 0)
            {
                <tr>
                    <td colspan="11" class="text-center">
                        @ViewResources.NoInformationAvailable
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
@section Foot {
    <script src="~/scripts/Menu/Manage.js" type="text/javascript"></script>
}
@{
    void IndentChildMenuItem(IMenuItem menuItem, List<IMenuItem> listMenuItem, int level = 0)
    {
        if (!ReferenceEquals(menuItem.Parent, null))
        {
            if (menuItem.Parent.Id > 0)
            {
                var parent = listMenuItem.Where(m => m.Id == menuItem.Parent.Id).FirstOrDefault();

                IndentChildMenuItem(parent, listMenuItem, level + 1);
            }
        }
        else
        {
            for (var i = 0; i < level; i++)
            {
                if (i == level - 1)
                {
                    <span class="tree-mode-only">&#9492;&#9472;&#9472;</span>
                }
                else
                {
                    <span class="invisible tree-mode-only">&#9492;&#9472;&#9472;</span>
                }
            }
        }

        if (level == 0)
        {
            @menuItem.Name
        }
    }
}
