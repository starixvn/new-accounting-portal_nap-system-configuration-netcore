@model NapAdmin.ViewModels.User.AssignNewSiteVM

@{
    ViewBag.Title = ViewResources.Assign_New_Site;
    var headline = string.Format("Assign New Site to User '{0}'", Model.UserName);
    var availableSite = Model.AvailableSitesForUser;
    var hostRightSite = Model.HostRightSites;
    var currentUserSiteLevelList = Model.CurrentUserSiteLevelList;
    var numberSitesAvailableToAssign = 0;
}

@section Head {
    <link href="~/themes/nap/user/assign-new-site.css" rel="stylesheet" type="text/css" />
}

@section Headline {
    <h1>
        <span class="title">
            <span class="first">@ViewResources.User_Management /</span>
            @headline
        </span>
        <div class="button-action">
            @Html.ActionLink("← " + ViewResources.Back_To_List, "AssignSite", "User",
                new
                {
                    id = Model.UserId,
                    returnUserName = Model.ReturnData.ReturnUserName,
                    returnSiteId = Model.ReturnData.ReturnSiteId,
                    returnGroupId = Model.ReturnData.ReturnGroupId,
                    returnPageIndex = Model.ReturnData.ReturnPageIndex
                }, new { @class = "back-button" })
        </div>
    </h1>
}

@Html.Hidden("UserId", Model.UserId)
@Html.Hidden("ReturnUserName", Model.ReturnData.ReturnUserName)
@Html.Hidden("ReturnSiteId", Model.ReturnData.ReturnSiteId)
@Html.Hidden("ReturnGroupId", Model.ReturnData.ReturnGroupId)
@Html.Hidden("ReturnPageIndex", Model.ReturnData.ReturnPageIndex)

@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-sm-5 col-md-4 common-form" }))
{
    <div class="form-group summary">
        <div class="col-sm-3">
            @Html.Label(ViewResources.Username)
        </div>
        <div class="col-sm-8 rdo-field">
            @Html.Label(Model.UserName)
        </div>
    </div>
    <div class="form-group summary">
        <div class="col-sm-3">
            @Html.Label(ViewResources.Site)
        </div>
        <div class="col-sm-8">
            <select id="siteSelect">
                @foreach (var site in availableSite)
                {
                    var currentUserSiteLevel = currentUserSiteLevelList.Where(s => s.SiteId == site.Id).FirstOrDefault();

                    if (currentUserSiteLevel != null && hostRightSite != null &&
                        currentUserSiteLevel.Level >= (int)AdminConstant.Level.User &&
                        hostRightSite.Count(s => s.Id == site.Id) > 0)
                    {
                        numberSitesAvailableToAssign++;
                        <option value="@site.Id">@site.Name</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="form-group summary">
        <div class="col-sm-3">
            @Html.Label(ViewResources.Level)
        </div>
        <div class="col-sm-8">
            <select id="levelSelect">
                <option value="0">@ViewResources.User</option>
                @if (Model.Level == (int)AdminConstant.Level.PortalAdmin)
                {
                    <option value="50">@ViewResources.Site_Admin</option>
                }
            </select>
        </div>
    </div>
    <div class="form-group summary">
        <div class="col-sm-3"></div>
        <div class="col-sm-8">
            @{
                var btnSaveEnabled = numberSitesAvailableToAssign == 0 ? "disabled=\"disabled\"" : string.Empty;
                <input type="submit" value="@ViewResources.Save" id="btn-submit" @Html.Raw(@btnSaveEnabled) />
            }
            <button class="cancel-button"
                    onclick="NAP.redirect('User/AssignSite/@Model.UserId?returnUserName=@Model.ReturnData.ReturnUserName&returnSiteId=@Model.ReturnData.ReturnSiteId&returnPageIndex=@Model.ReturnData.ReturnPageIndex&returnGroupId=@Model.ReturnData.ReturnGroupId', 0); return false;">
                @ViewResources.Cancel
            </button>
        </div>
    </div>
                }

@section Foot {
    <script src="~/scripts/User/AssignNewSite.js" type="text/javascript"></script>
}