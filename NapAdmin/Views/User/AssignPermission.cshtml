@model NapAdmin.ViewModels.User.AssignPermissionVM

@{
    var viewFlags = ViewBag.ViewFlags as ViewFlags;

    bool success = ViewBag.Success != null && ViewBag.Success;

    var functionList = Model.FunctionList;
    var userFuncPolicyList = Model.UserFuncPolicyList;
    var currentUserFuncPolicyList = Model.CurrentUserFuncPolicyList;
    var groupFuncPolicyList = Model.GroupFuncPolicyList;
    var adminLevel = Model.AdminLevel;
    var userLevel = Model.UserLevel;
    var isAssignable = userLevel < 50; // do not allow assigning permission if the user is site-admin or portal-admin

    ViewBag.Title = ViewResources.Permission;
    string headline = isAssignable && viewFlags.HasAssignFunctionRight
        ? string.Format("Assign Permission to User '{0}'", Model.Criteria.Username)
        : string.Format("Permission of User '{0}'", Model.Criteria.Username);
}
@section Head {
    @Styles.Render("~/Areas/UserControl/themes/BasicStyles")
}
@section Headline {
    <span class="title">
        <span class="first">@ViewResources.User_Management /</span>
        @headline
    </span>
    <div class="button-action">
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User",
                new
                {
                    userName = Model.ReturnData.ReturnUserName,
                    siteId = Model.ReturnData.ReturnSiteId,
                    id = Model.ReturnData.ReturnPageIndex,
                    groupId = Model.ReturnData.ReturnGroupId
                }, new { @class = "back-button" })
    </div>
}
@if (viewFlags.IsNapAdminSite)
{
    using (Html.BeginForm("AssignPermission", "User", FormMethod.Get, new { @class = "form-inline col-sm-12 filter-form" }))
    {
        @Html.HiddenFor(m => m.ReturnData.ReturnUserName, new { @Name = "returnUserName" })
        @Html.HiddenFor(m => m.ReturnData.ReturnSiteId, new { @Name = "returnSiteId" })
        @Html.HiddenFor(m => m.ReturnData.ReturnGroupId, new { @Name = "returnGroupId" })
        @Html.HiddenFor(m => m.ReturnData.ReturnPageIndex, new { @Name = "returnPageIndex" })

        <div class="form-group">
            @Html.LabelFor(m => m.Criteria.SiteId)
            @Html.DropDownListFor(m => m.Criteria.SiteId, Model.Sites as List<SelectListItem>, new { @Name = "siteId" })
        </div>
        <div class="form-group">
            <input type="submit" value="@ViewResources.Submit" />
        </div>
    }

}
@using (Html.BeginForm())
{
    <table class="grid no-scale">
        <thead>
            <tr>
                <th rowspan="2">
                    @ViewResources.Function
                </th>
                <th colspan="2">
                    @ViewResources.User @ViewResources.Permission
                </th>
                <th colspan="2">
                    @ViewResources.Group @ViewResources.Permission
                </th>
            </tr>
            <tr>
                <th style="width: 50px">
                    @ViewResources.Read
                    <input title="Check/Uncheck All" id="chkAllFuncRead" type="checkbox" />
                </th>
                <th style="width: 50px">
                    @ViewResources.Host
                    <input title="Check/Uncheck All" id="chkAllFuncHost" type="checkbox" />
                </th>
                <th style="width: 50px">
                    @ViewResources.Read
                </th>
                <th style="width: 50px">
                    @ViewResources.Host
                </th>
            </tr>
        </thead>
        <tbody>

            @if (functionList.Count > 0)
            {
                var functionCount = functionList.Count;
                for (int i = 0; i < functionCount; i++)
                {
                    var function = functionList[i];
                    var userFuncPolicy = userFuncPolicyList.Where(x => x.Function.Id == function.Id).SingleOrDefault();
                    var currentUserFuncPolicy = currentUserFuncPolicyList.Where(x => x.Function.Id == function.Id).SingleOrDefault();
                    var groupFuncPolicy = new FunctionPolicy();
                    if (!ReferenceEquals(groupFuncPolicyList, null))
                    {
                        groupFuncPolicy = groupFuncPolicyList.Where(x => x.Function.Id == function.Id).FirstOrDefault();
                    }

                    var funcNameStyle = i == functionCount - 1 ? "nbt" : "nbt nbb";
                    if (function.Parent == null)
                    {
                        funcNameStyle = i == functionCount - 1 ? string.Empty : "nbb";
                    }
                    string parentId = function.Parent != null ? function.Parent.Id.ToString() : string.Empty;
                    string chkReadId = "funcRead" + function.Id;
                    string checkedReadCss = userFuncPolicy != null && userFuncPolicy.Policy >= (int)Constant.Policy.Read
                        ? "checked='checked'" : string.Empty;
                    bool isReadDisabled = !isAssignable ||
                        (adminLevel != (int)Constant.Level.PortalAdmin
                        && (currentUserFuncPolicy == null || currentUserFuncPolicy.Policy < (int)Constant.Policy.Read
                        || (userFuncPolicy != null && currentUserFuncPolicy.Policy < userFuncPolicy.Policy)));

                    <tr>
                        <td class="@Html.Raw(funcNameStyle)">
                            @IndentChildFunctions(functionList, function)
                        </td>
                        <td class="text-center">
                            @if (isReadDisabled)
                            {
                                <input disabled="disabled" type="checkbox" @Html.Raw(checkedReadCss) />
                                if (!string.IsNullOrWhiteSpace(checkedReadCss))
                                {
                                    <input id="@chkReadId" name="criteria.funcRead" value="@function.Id" pid="@parentId" type="hidden" />
                                }
                            }
                            else
                            {
                                <input id="@chkReadId" name="criteria.funcRead" value="@function.Id" pid="@parentId"
                                       type="checkbox" @Html.Raw(checkedReadCss) />
                            }
                        </td>
                        <td class="text-center">
                            @if (function.Crud > 0)
                        {
                            string chkHostId = "funcHost" + function.Id;
                            string checkedHostCss = userFuncPolicy != null && userFuncPolicy.Policy >= (int)Constant.Policy.Host
                                ? "checked='checked'" : string.Empty;
                            bool isHostDisabled = !isAssignable ||
                                (adminLevel != (int)Constant.Level.PortalAdmin
                                && (currentUserFuncPolicy == null || currentUserFuncPolicy.Policy < (int)Constant.Policy.Host
                                || (userFuncPolicy != null && currentUserFuncPolicy.Policy < userFuncPolicy.Policy)));

                            if (isHostDisabled)
                            {
                                    <input disabled="disabled" type="checkbox" @Html.Raw(checkedHostCss) />
                                    if (!string.IsNullOrWhiteSpace(checkedHostCss))
                                    {
                                        <input id="@chkHostId" name="criteria.funcHost" value="@function.Id" pid="@parentId" type="hidden" />
                                    }
                                }
                                else
                                {
                                    <input id="@chkHostId" name="criteria.funcHost" value="@function.Id" pid="@parentId"
                                           type="checkbox" @Html.Raw(checkedHostCss) />
                                }
                            }
                        </td>
                        <td class="text-center">
                            @if (groupFuncPolicyList != null)
                        {
                            string checkedGroupReadCss =
                                groupFuncPolicy != null && groupFuncPolicy.Policy >= (int)Constant.Policy.Read
                                ? "checked='checked'" : string.Empty;

                                <input disabled="disabled" type="checkbox" pid="@parentId" @Html.Raw(checkedGroupReadCss) />
                            }
                        </td>
                        <td class="text-center">
                            @if (function.Crud > 0 && groupFuncPolicyList != null)
                        {
                            string checkedGroupHostCss =
                                groupFuncPolicy != null && groupFuncPolicy.Policy >= (int)Constant.Policy.Host
                                ? "checked='checked'" : string.Empty;

                                <input disabled="disabled" type="checkbox" pid="@parentId" @Html.Raw(checkedGroupHostCss) />
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">
                        @ViewResources.NoInformationAvailable
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @Html.HiddenFor(m => m.ReturnData.ReturnUserName)
    @Html.HiddenFor(m => m.ReturnData.ReturnSiteId)
    @Html.HiddenFor(m => m.ReturnData.ReturnGroupId)
    @Html.HiddenFor(m => m.ReturnData.ReturnPageIndex)

    @Html.Hidden("HasAssignPermission", viewFlags.HasAssignFunctionRight)
    @Html.HiddenFor(c => c.Criteria.UserId)
    @Html.HiddenFor(c => c.Criteria.SiteId)

    if (isAssignable && viewFlags.HasAssignFunctionRight)
    {
        <div class="button-list">
            <input type="submit" value="@ViewResources.Save" />
            <button class="cancel-button" onclick="NAP.redirect('User/Manage/@Model.ReturnData.ReturnPageIndex?userName=@Model.ReturnData.ReturnUserName&siteId=@Model.ReturnData.ReturnSiteId&groupId=@Model.ReturnData.ReturnGroupId', 0); return false;">@ViewResources.Cancel</button>
        </div>
    }
}
@section Foot {
    <script src="~/Areas/UserControl/scripts/User/AssignPermission.js" type="text/javascript"></script>
    @if (ViewBag.Success != null && ViewBag.Success)
    {
        <script type="text/javascript">
            $(function () {
                NAP.headlineMsgBox.showInfo('@ViewResources.Your_changes_were_saved', { closeBtn: false });
            });
        </script>
    }
}
@helper IndentChildFunctions(List<IFunction> functionList, IFunction function, int level = 0)
{
if (function.Parent != null)
{
    var parent = functionList.Where(x => x.Id == function.Parent.Id).SingleOrDefault();

        @IndentChildFunctions(functionList, parent, level + 1)
}
else
{
    for (int i = 0; i < level; i++)
    {
        if (i == level - 1)
        {
                <span>&#9492;&#9472;&#9472;</span>
        }
        else
        {
                <span class="invisible">&#9492;&#9472;&#9472;</span>
        }
    }
}

if (level == 0)
{
        @function.Name
}
}