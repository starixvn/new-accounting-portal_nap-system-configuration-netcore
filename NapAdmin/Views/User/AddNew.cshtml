@model NapAdmin.ViewModels.User.AddNewUserVM
@{
    ViewBag.Title = ViewResources.Create_New_User;

    bool success = ViewBag.Success != null && ViewBag.Success;
}
@section Head {
    <link type="text/css" rel="stylesheet" href="~/themes/nap/style.css" />
}
@section Headline {
    <span class="title">
        <span class="first">@ViewResources.User_Management /</span> @ViewBag.Title
    </span>
    <div class="button-action">
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User",
           new
           {
               userName = Model.ReturnData.ReturnUserName,
               siteId = Model.ReturnData.ReturnSiteId,
               id = Model.ReturnData.ReturnPageIndex,
               groupId = Model.ReturnData.ReturnGroupId
           },
           new { @class = "back-button" })
    </div>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-sm-7 col-md-5 common-form" }))
{
    <div class="form-group summary">
        @Html.ValidationSummary()
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(c => c.Criteria.Username)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(c => c.Criteria.Username, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(c => c.Criteria.UserPwd)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.PasswordFor(c => c.Criteria.UserPwd, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(c => c.Criteria.FirstName)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(c => c.Criteria.FirstName, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">@Html.LabelFor(c => c.Criteria.LastName)</div>
        <div class="col-xs-12 col-sm-8">@Html.TextBoxFor(c => c.Criteria.FirstName, new { @class = "form-control" })</div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">@Html.LabelFor(c => c.Criteria.Email)</div>
        <div class="col-xs-12 col-sm-8">@Html.TextBoxFor(c => c.Criteria.Email, new { @class = "form-control" })</div>
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">@Html.LabelFor(c => c.Criteria.GroupId)</div>
        <div class="col-xs-12 col-sm-8">
            @Html.DropDownListFor(c => c.Criteria.GroupId, (List<SelectListItem>)ViewBag.Groups, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-offset-3 col-xs-12 col-sm-8">
            @if (!success)
            {
                <input type="submit" value="@ViewResources.Save" />
                <button class="cancel-button"
                        onclick="NAP.redirect('User/Manage/@Model.ReturnData.ReturnPageIndex?userName=@Model.ReturnData.ReturnUserName&amp;siteId=@Model.ReturnData.ReturnSiteId&amp;groupId=@Model.ReturnData.ReturnGroupId', 0); return false;">
                    @ViewResources.Cancel
                </button>
            }
        </div>
    </div>

    @Html.HiddenFor(m => m.ReturnData.ReturnUserName)
    @Html.HiddenFor(m => m.ReturnData.ReturnSiteId)
    @Html.HiddenFor(m => m.ReturnData.ReturnGroupId)
    @Html.HiddenFor(m => m.ReturnData.ReturnPageIndex)
}
@section Foot {
    @if (success)
    {
        var dialogMsg = string.Format(ViewResources.Add_New_User_Success, Model.Criteria.Username, 3);

        <script type="text/javascript">
            $(function () {
                var url = 'User/AssignSite/' + '@ViewBag.UserId' + '?returnUserName=' + '@Model.ReturnData.ReturnUserName' + '&returnGroupId=' + '@Model.ReturnData.ReturnGroupId' + '&returnSiteId=' + '@Model.ReturnData.ReturnSiteId';
                NAP.showSuccessMsg('@dialogMsg', url, 3000);
            });
        </script>
    }
}