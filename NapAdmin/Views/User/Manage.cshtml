@using System.Collections
@model PagerList<UserLevel>
@{
    ViewBag.Title = ViewResources.Manage_User;

    var viewFlags = (ViewFlags)ViewBag.ViewFlags;
    var viewFlagsCurrentSite = (ViewFlags)ViewBag.ViewFlagsCurrentSite;

    var isPortalAdmin = ViewBag.IsPortalAdmin != null ? (bool)ViewBag.IsPortalAdmin : false;
    var level = ViewBag.Level != null ? (int)ViewBag.Level : 0;
    var userId = ViewBag.UserId != null ? (int)ViewBag.UserId : 0;
    var siteId = ViewBag.SiteId != null ? (int)ViewBag.SiteId : 0;
    var returnGroupId = ViewBag.ReturnGroupId != null ? (int)ViewBag.ReturnGroupId : 0;

    var hashManageUser = ViewBag.HashManageUser != null ? (Hashtable)ViewBag.HashManageUser : new Hashtable();
    var hashAssignFunction = ViewBag.HashAssignFunction != null ? (Hashtable)ViewBag.HashAssignFunction : new Hashtable();
    var hashAssignSite = ViewBag.HashAssignSite != null ? (Hashtable)ViewBag.HashAssignSite : new Hashtable();
    var listSiteLevel = ViewBag.ListSiteLevel != null ? (List<SiteLevel>)ViewBag.ListSiteLevel : new List<SiteLevel>();
    var isShowSite = siteId != 0;
}
@section Head {
    @Styles.Render("~/Areas/UserControl/user")
}
@section Headline {
    <span class="title">
        <span class="first">@ViewResources.User_Management /</span> @ViewBag.Title
    </span>
    <div class="button-action">
        @if (viewFlags.HasEditRight)
        {
            @Html.ActionLink("+ " + ViewResources.Create_New_User, "AddNew", "User",
                     new
                     {
                         ReturnUserName = ViewBag.Username,
                         ReturnSiteId = siteId,
                         ReturnGroupId = returnGroupId,
                         ReturnPageIndex = Model.CurrentPageIndex
                     }, new { @class = "add-button" })
            @Html.ActionLink("+ " + ViewResources.Add_Existing_User, "AddExisting", "User",
                       new
                       {
                           ReturnUserName = ViewBag.Username,
                           ReturnSiteId = siteId,
                           ReturnGroupId = returnGroupId,
                           ReturnPageIndex = Model.CurrentPageIndex
                       }, new { @class = "add-button" })
        }
    </div>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-inline col-sm-12 filter-form" }))
{
    <div class="form-group">
        @Html.Label(ViewResources.Username)
        <input type="hidden" value="@(ViewBag.Username)" id="hdnUsename" />
        <input type="text" value="@(ViewBag.Username)" name="userName" id="Username" />
    </div>
        <div class="form-group">
            @Html.Label("GroupId", ViewResources.Group)
            @Html.DropDownList("GroupId", (List<SelectListItem>)ViewBag.GroupSelectList, ViewResources.All_Groups)
        </div>
    if (viewFlags.IsNapAdminSite)
    {
        <div class="form-group">
            @Html.Label("SiteId", ViewResources.Site)
            @Html.DropDownList("SiteId", (List<SelectListItem>)ViewBag.SiteSelectList)
        </div>
            <div class="form-group">
                @Html.Label("StatusId", "Status")
                @Html.DropDownList("StatusId", new List<SelectListItem> {
                new SelectListItem { Text = "All", Value = "0"  },
                new SelectListItem { Text = "Active", Value = "1" , Selected = true },
                new SelectListItem { Text = "Inactive", Value = "2"  },
                new SelectListItem { Text = "Closed", Value = "3"  }
            })
            </div>
    }

    <div class="form-group">
        <input type="submit" value="@ViewResources.Submit" />
    </div>
}
<table class="col-sm-12 grid">
    <thead>
        <tr>
            <th class="first">
                #
            </th>
            <th>
                @ViewResources.Username
            </th>
            <th>
                @ViewResources.First_Name
            </th>
            @if (isShowSite)
            {
                <th>
                    @ViewResources.Site
                </th>
            }
            <th>
                @ViewResources.Group
            </th>
            @if (viewFlags.IsShowLevelColumn)
            {
                <th>
                    @ViewResources.Level
                </th>
            }
            <th>
                @ViewResources.Creator
            </th>
            <th>
                @ViewResources.Created_Date
            </th>
            <th>
                @ViewResources.Last_Login_Date
            </th>
            <th>
                @ViewResources.Status
            </th>
            @if (viewFlags.IsShowActionColumn)
            {
                <th>
                    @ViewResources.Action
                </th>
            }
        </tr>
    </thead>
    <tbody id="grid-user">
        @if (!ReferenceEquals(Model, null) && Model.Count() > 0)
            {
                int i = 0;
                foreach (var item in Model)
                {
                    string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";

                <tr @Html.Raw(rowCss)>
                    <td class="text-center">
                        @((i + 1) + ((Model.CurrentPageIndex - 1) * Model.PageSize))
                    </td>
                    <td>
                        <a href="javascript:;" uid="@item.User.Id" class="lnk-user-info"
                           title="@ViewResources.View_details_of '@item.User.Username'">@item.User.Username</a>
                    </td>
                    <td>
                        @(item.User.FirstName != null ? item.User.FirstName : string.Empty)
                    </td>
                    @if (isShowSite)
                    {
                        <td>
                            @(item.Site != null ? item.Site.Name : string.Empty)
                        </td>
                    }
                    <td>
                        @(item.User.Group != null ? item.User.Group.Name : string.Empty)
                    </td>
                    @if (viewFlags.IsShowLevelColumn)
                    {
                        <td class="text-center">
                            @if (!ReferenceEquals(item.Site, null))
                            {
                                @item.Level.ToUserLevel()
                            }
                        </td>
                    }
                    <td>
                        @(item.User.Creator != null ? item.User.Creator.Username : string.Empty)
                    </td>
                    <td class="text-center">
                        @item.User.CreatedDate.ToFullDateString()
                    </td>
                    <td class="text-center">
                        @if (item.User.LastLoginDate != DateTime.MinValue)
                    {
                            @item.User.LastLoginDate.ToFullDateString()
                        }
                        else
                        {
                            @ViewResources.NA
                        }
                    </td>
                    <td class="text-center">
                        @{
                            var status = ((Constant.UserStatus)item.Status);

                            if (status != Constant.UserStatus.All)
                            {
                                <div class="@(status == Constant.UserStatus.Closed ? "text-danger": string.Empty)">
                                    @status
                                </div>
                            }
                        }
                    </td>
                    @if (siteId != Constant.SearchAllSite)
                    {
                        if (viewFlags.HasEditRight || viewFlags.HasAssignSiteRight || viewFlags.HasAssignFunctionRight)
                        {
                            bool visible = item.User.Id == userId || level > item.Level
                                || (item.Level == (int)Constant.Level.User && level == item.Level);

                            bool isSiteAdmin = level >= (int)Constant.Level.SiteAdmin;

                            <td class="text-center">
                                <div class="action-wrp">
                                    @if (visible)
                            {
                                        <span class="btn-action">@ViewResources.Action</span>
                                            <div class="relative">
                                                <ul class="actions">
                                                    @if (viewFlags.HasEditRight && visible && item.User.Id != userId)
                                                    {
                                                        <li>
                                                            @Html.ActionLink(string.Format("{0} '{1}' {2}", ViewResources.Edit, item.User.Username, ViewResources.Details),
                                                    "Edit", new
                                                    {
                                                        id = item.User.Id,
                                                        returnUserName = ViewBag.Username,
                                                        returnSiteId = siteId,
                                                        returnGroupId = returnGroupId,
                                                        returnPageIndex = Model.CurrentPageIndex
                                                    }, new { @class = "dd-edit" })
                                                        </li>
                                                        <li>
                                                            @Html.ActionLink(string.Format("{0} '{1}' {2}", ViewResources.Reset, item.User.Username, ViewResources.Password),
                                                        "ResetPassword", new
                                                        {
                                                            id = item.User.Id,
                                                            returnUserName = ViewBag.Username,
                                                            returnSiteId = siteId,
                                                            returnGroupId = returnGroupId,
                                                            returnPageIndex = Model.CurrentPageIndex
                                                        }, new { @class = "dd-chgpwd" })
                                                        </li>
                                                    }
                                                    @if ((viewFlags.HasAssignSiteRight || isSiteAdmin) && visible)
                                                    {
                                                        <li>
                                                            @Html.ActionLink(string.Format("View Sites of '{0}'", item.User.Username), "AssignSite",
                                                    new
                                                    {
                                                        id = item.User.Id,
                                                        returnUserName = ViewBag.Username,
                                                        returnSiteId = siteId,
                                                        returnGroupId = returnGroupId,
                                                        returnPageIndex = Model.CurrentPageIndex
                                                    }, new { @class = "dd-site" })
                                                        </li>
                                                    }
                                                    @if ((viewFlags.HasAssignFunctionRight || isSiteAdmin) && visible && viewFlags.IsShowLevelColumn)
                                                    {
                                                        <li>
                                                            @Html.ActionLink(string.Format("View Permission of '{0}'", item.User.Username), "AssignPermission",
                                                    new
                                                    {
                                                        id = item.User.Id,
                                                        siteId = siteId,
                                                        returnUserName = ViewBag.Username,
                                                        returnSiteId = siteId,
                                                        returnGroupId = returnGroupId,
                                                        returnPageIndex = Model.CurrentPageIndex
                                                    }, new { @class = "dd-permission" })
                                                        </li>
                                                    }
                                                    @if (((viewFlags.HasAssignSiteRight && viewFlags.HasAssignFunctionRight) || isSiteAdmin) && visible)
                                                    {
                                                        <li>
                                                            @Html.ActionLink(string.Format("View Site/Function of '{0}'", item.User.Username), "AssignSiteFunction",
                                                new
                                                {
                                                    id = item.User.Id,
                                                    returnUserName = ViewBag.Username,
                                                    returnSiteId = siteId,
                                                    returnGroupId = returnGroupId,
                                                    returnPageIndex = Model.CurrentPageIndex
                                                }, new { @class = "dd-site" })
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                    }
                                </div>
                            </td>
                        }
                    }
                    else
                    {
                        if (!ReferenceEquals(item.Site, null))
                        {
                            viewFlags.HasEditRight = (hashManageUser.Contains(item.Site.Id) ? ((int)hashManageUser[item.Site.Id] >= (int)Constant.Policy.Host) : false)
                                                        && viewFlagsCurrentSite.HasManageUserRight;
                            viewFlags.HasAssignSiteRight = (hashAssignSite.Contains(item.Site.Id) ? ((int)hashAssignSite[item.Site.Id] >= (int)Constant.Policy.Read) : false)
                                                        && viewFlagsCurrentSite.HasAssignSiteRight;
                            viewFlags.HasAssignFunctionRight = (hashAssignFunction.Contains(item.Site.Id) ? ((int)hashAssignFunction[item.Site.Id] >= (int)Constant.Policy.Read) : false)
                                                        && viewFlagsCurrentSite.HasAssignFunctionRight;
                        }
                        else
                        {
                            viewFlags.HasEditRight = viewFlagsCurrentSite.HasManageUserRight;
                            viewFlags.HasAssignSiteRight = viewFlagsCurrentSite.HasAssignSiteRight;
                            viewFlags.HasAssignFunctionRight = false;
                        }

                        if (viewFlags.HasEditRight || viewFlags.HasAssignSiteRight || viewFlags.HasAssignFunctionRight)
                        {
                            bool visible =
                                (isPortalAdmin)
                                ||
                                (item.User.Id == userId || (level > item.Level || !item.IsActive)
                                || (item.User.Id == userId || item.Level == (int)Constant.Level.User) && level == item.Level);

                            int returnSiteId = (int)Constant.SearchAllSite;
                            var currentSite = item.Site != null ? (listSiteLevel.Where(s => s.Site.Id == item.Site.Id).FirstOrDefault()) : null;
                            bool isSiteAdmin = currentSite != null ? currentSite.Level >= (int)Constant.Level.SiteAdmin : false;

                            <td class="text-center">
                                <div class="action-wrp">
                                    @if (visible)
                            {
                                        <span class="btn-action">@ViewResources.Action</span>
                                            <div class="relative">
                                                <ul class="actions">
                                                    @if (viewFlags.HasEditRight && visible && item.Level != (int)Constant.Level.SiteAdmin || item.User.Id == userId)
                                                    {
                                                        <li>
                                                            @Html.ActionLink(string.Format("{0} '{1}' {2}", ViewResources.Edit, item.User.Username, ViewResources.Details),
                                                    "Edit", new
                                                    {
                                                        id = item.User.Id,
                                                        returnUserName = ViewBag.Username,
                                                        returnSiteId = siteId,
                                                        returnGroupId = returnGroupId,
                                                        returnPageIndex = Model.CurrentPageIndex
                                                    }, new { @class = "dd-edit" })
                                                        </li>
                                                        <li>
                                                            @Html.ActionLink(string.Format("{0} '{1}' {2}", ViewResources.Reset, item.User.Username, ViewResources.Password),
                                                    "ResetPassword", new
                                                    {
                                                        id = item.User.Id,
                                                        returnUserName = ViewBag.Username,
                                                        returnSiteId = siteId,
                                                        returnGroupId = returnGroupId,
                                                        returnPageIndex = Model.CurrentPageIndex
                                                    }, new { @class = "dd-chgpwd" })
                                                        </li>
                                                    }
                                                    @if ((viewFlags.HasAssignSiteRight || isSiteAdmin) && visible)
                                                    {
                                                        <li>
                                                            @Html.ActionLink(string.Format("View Sites of '{0}'", item.User.Username), "AssignSite",
                                                new
                                                {
                                                    id = item.User.Id,
                                                    returnUserName = ViewBag.Username,
                                                    returnSiteId = siteId,
                                                    returnGroupId = returnGroupId,
                                                    returnPageIndex = Model.CurrentPageIndex
                                                }, new { @class = "dd-site" })
                                                        </li>
                                                    }
                                                    @if ((viewFlags.HasAssignFunctionRight || isSiteAdmin) && visible)
                                                    {
                                                        <li>
                                                            @Html.ActionLink(string.Format("View Permission of '{0}'", item.User.Username), "AssignPermission",
                                                new
                                                {
                                                    id = item.User.Id,
                                                    siteId = item.Site != null ? item.Site.Id : returnSiteId,
                                                    returnUserName = ViewBag.Username,
                                                    returnSiteId = siteId,
                                                    returnGroupId = returnGroupId,
                                                    returnPageIndex = Model.CurrentPageIndex
                                                }, new { @class = "dd-permission" })
                                                        </li>
                                                    }

                                                    @if (((viewFlags.HasAssignSiteRight && viewFlags.HasAssignFunctionRight) || isSiteAdmin) && visible)
                                                    {
                                                        <li>
                                                            @Html.ActionLink(string.Format("View Site/Function of '{0}'", item.User.Username), "AssignSiteFunction",
                                                    new
                                                    {
                                                        id = item.User.Id,
                                                        returnUserName = ViewBag.Username,
                                                        returnSiteId = siteId,
                                                        returnGroupId = returnGroupId,
                                                        returnPageIndex = Model.CurrentPageIndex
                                                    }, new { @class = "dd-site" })
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                    }
                                </div>
                            </td>
                        }
                        else
                        {
                            <td class="text-center"></td>
                        }
                    }
                </tr>

                                    i++;
                                }
                            }
                            else
                            {
                                <tr class="no-info">
                                    <td colspan="12" class="text-center">
                                        @ViewResources.NoInformationAvailable
                                    </td>
                                </tr>
                            }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="12">
                @if (Model != null && Model.Count() > 0)
                {
                    <span class="items-per-page-wrp">
                        @ViewResources.PageSize
                        @Html.DropDownList("items-per-page", new List<SelectListItem> {
                            new SelectListItem { Value = "10", Text = "10", Selected = "10" == Model.PageSize.ToString() },
                            new SelectListItem { Value = "20", Text = "20", Selected = "20" == Model.PageSize.ToString() },
                            new SelectListItem { Value = "30", Text = "30", Selected = "30" == Model.PageSize.ToString() }
                        }, new { id = string.Empty, @class = "items-per-page" })
                    </span>
                        @Html.Pager(Model.TotalItemCount, Model.PageSize, Model.CurrentPageIndex, new PagerOptions()
                   {
                       PageIndexParameterName = "id",
                       ShowFirstLast = true,
                       ShowPrevNext = true,
                       ShowDisabledPagerItems = true,
                       ShowMorePagerItems = true,
                       NumericPagerItemCount = 20,
                       CurrentPagerItemTemplate = "<a disabled='disabled'>{0}</a>",                       
                       CssClass = "jpages"
                   })
                }
            </td>
        </tr>
    </tfoot>
</table>
@section Foot {
    <script src="~/Areas/UserControl/scripts/User/Manage.js" type="text/javascript"></script>
}