@using System.Collections
@using NapAdminCore.Helpers;
@model PagerList<UserLevel>
@{
    ViewBag.Title = ViewResources.Manage_User;

    var viewFlags = (ViewFlags)ViewBag.ViewFlags;
    var viewFlagsCurrentSite = (ViewFlags)ViewBag.ViewFlagsCurrentSite;

    var isPortalAdmin = (bool)ViewBag.IsPortalAdmin;

    var userId = (int)ViewBag.UserId;
    var siteId = (int)ViewBag.SiteId;
    var returnGroupId = ViewBag.ReturnGroupId != null ? (int)ViewBag.ReturnGroupId : 0;

    var hashLevel = (Hashtable)ViewBag.HashLevel;
    var hashManageUser = (Hashtable)ViewBag.HashManageUser;
    var hashAssignFunction = (Hashtable)ViewBag.HashAssignFunction;
    var hashAssignSite = (Hashtable)ViewBag.HashAssignSite;
}
@section Head {
    <link type="text/css" rel="stylesheet" href="~/themes/nap/user/manage.css" />
}
@section Headline {
    <span class="title">
        <span class="first">@ViewResources.User_Management /</span> @ViewBag.Title
    </span>
    <div class="button-action">
        @if (viewFlags.HasEditRight)
        {
            @Html.ActionLink("+ " + ViewResources.Create_New_User, "AddNew", "User",
                    new
                    {
                        ReturnUserName = ViewBag.Username,
                        ReturnSiteId = siteId,
                        ReturnGroupId = returnGroupId,
                        ReturnPageIndex = Model.CurrentPageIndex
                    }, new { @class = "add-button" })
            @Html.ActionLink("+ " + ViewResources.Add_Existing_User, "AddExisting", "User",
                    new
                    {
                        ReturnUserName = ViewBag.Username,
                        ReturnSiteId = siteId,
                        ReturnGroupId = returnGroupId,
                        ReturnPageIndex = Model.CurrentPageIndex
                    }, new { @class = "add-button" })
        }
    </div>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-inline col-sm-12 filter-form" }))
{
    <div class="form-group">
        @Html.Label(ViewResources.Username)
        <input type="hidden" value="@(ViewBag.Username)" id="hdnUsename" />
        <input type="text" value="@(ViewBag.Username)" name="userName" id="Username" />
    </div>
    <div class="form-group">
        @Html.Label("GroupId", ViewResources.Group)
        @Html.DropDownList("GroupId", (List<SelectListItem>)ViewBag.GroupSelectList, ViewResources.All_Groups)
    </div>
    <div class="form-group">
        @Html.Label("SiteId", ViewResources.Site)
        @Html.DropDownList("SiteId", (List<SelectListItem>)ViewBag.SiteSelectList)
    </div>
    <div class="form-group">
        @Html.Label("StatusId", "Status")
        @Html.DropDownList("StatusId", new List<SelectListItem> {
    new() { Text = "All", Value = "0"  },
    new() { Text = "Active", Value = "1" , Selected = true },
    new() { Text = "Inactive", Value = "2"  },
    new() { Text = "Closed", Value = "3"  }
    })
    </div>

    <div class="form-group">
        <input type="submit" value="@ViewResources.Submit" />
    </div>
}
<table class="col-sm-12 grid">
    <thead>
        <tr>
            <th class="first">
                #
            </th>
            <th>
                @ViewResources.Username
            </th>
            <th>
                @ViewResources.First_Name
            </th>

            <th>
                @ViewResources.Site
            </th>

            <th>
                @ViewResources.Group
            </th>

            <th>
                @ViewResources.Level
            </th>

            <th>
                @ViewResources.Creator
            </th>
            <th>
                @ViewResources.Created_Date
            </th>
            <th>
                @ViewResources.Last_Login_Date
            </th>
            <th>
                @ViewResources.Status
            </th>
            <th>
                @ViewResources.Action
            </th>
        </tr>
    </thead>
    <tbody id="grid-user">
        @if (!ReferenceEquals(Model, null) && Model.Count() > 0)
        {
            var i = 0;
            foreach (var item in Model)
            {
                var rowCss = i % 2 == 0 ? string.Empty : "class='alt'";

                <tr @Html.Raw(rowCss)>
                    <td class="text-center">
                        @(i + 1 + (Model.CurrentPageIndex - 1) * Model.PageSize)
                    </td>
                    <td>
                        <a href="javascript:;" uid="@item.UserId" class="lnk-user-info"
                           title="@ViewResources.View_details_of '@item.Username'">@item.Username</a>
                    </td>
                    <td>
                        @item.FirstName
                    </td>

                    <td>
                        @item.SiteName
                    </td>

                    <td>
                        @item.GroupName
                    </td>
                    <td class="text-center">
                        @if (item.SiteId > 0)
                        {
                            @item.Level.ToUserLevel()
                        }
                    </td>
                    <td>
                        @item.CreatorUsername
                    </td>
                    <td class="text-center">
                        @item.CreatedDate.ToFullDateString()
                    </td>
                    <td class="text-center">
                        @if (item.LastLoginDate != DateTime.MinValue)
                        {
                            @item.LastLoginDate.ToFullDateString()
                        }
                        else
                        {
                            @ViewResources.NA
                        }
                    </td>
                    <td class="text-center">
                        @{
                            var status = (AdminConstant.UserStatus)item.Status;

                            if (status != AdminConstant.UserStatus.All)
                            {
                                <div class="@(status == AdminConstant.UserStatus.Closed ? "text-danger": string.Empty)">
                                    @status
                                </div>
                            }
                        }
                    </td>
                    @{
                        var level = isPortalAdmin ? (int)AdminConstant.Level.PortalAdmin : hashLevel.SafeGetInt(item.SiteId);
                        var hasEditRight = (hashManageUser.SafeGetInt(item.SiteId) >= (int)AdminConstant.Policy.Host)
                        && viewFlagsCurrentSite.HasManageUserRight;
                        var hasAssignSiteRight = (hashAssignSite.SafeGetInt(item.SiteId) >= (int)AdminConstant.Policy.Read)
                        && viewFlagsCurrentSite.HasAssignSiteRight;
                        var hasAssignFunctionRight = (hashAssignFunction.SafeGetInt(item.SiteId) >= (int)AdminConstant.Policy.Read)
                        && viewFlagsCurrentSite.HasAssignFunctionRight;

                        var canEditDetail = hasEditRight && (level > item.Level || item.UserId == userId);

                        var canAssignSite = hasAssignSiteRight && level >= item.Level;

                        var canAssignPermission = hasAssignFunctionRight && level >= item.Level;

                        var canAssignSiteFunction = canAssignSite && canAssignPermission;

                        var canSeeActionButton = canEditDetail || canAssignPermission || canAssignSite || canAssignSiteFunction;
                    }

                    <td class="text-center">
                        @if (canSeeActionButton)
                        {
                            <div class="action-wrp">
                                <span class="btn-action">@ViewResources.Action</span>
                                <div class="relative">
                                    <ul class="actions">
                                        @if (canEditDetail)
                                        {
                                            <li>
                                                @Html.ActionLink(string.Format("{0} '{1}' {2}", ViewResources.Edit, item.Username, ViewResources.Details),
                                                         "Edit", new
                                                         {
                                                             id = item.UserId,
                                                             returnUserName = ViewBag.Username,
                                                             returnSiteId = siteId,
                                                             returnGroupId = returnGroupId,
                                                             returnPageIndex = Model.CurrentPageIndex
                                                         }, new { @class = "dd-edit" })
                                            </li>
                                            <li>
                                                @Html.ActionLink(string.Format("{0} '{1}' {2}", ViewResources.Reset, item.Username, ViewResources.Password),
                                                         "ResetPassword", new
                                                         {
                                                             id = item.UserId,
                                                             returnUserName = ViewBag.Username,
                                                             returnSiteId = siteId,
                                                             returnGroupId = returnGroupId,
                                                             returnPageIndex = Model.CurrentPageIndex
                                                         }, new { @class = "dd-chgpwd" })
                                            </li>
                                        }
                                        @if (canAssignSite)
                                        {
                                            <li>
                                                @Html.ActionLink(string.Format("View Sites of '{0}'", item.Username), "AssignSite",
                                                         new
                                                         {
                                                             id = item.UserId,
                                                             returnUserName = ViewBag.Username,
                                                             returnSiteId = item.SiteId,
                                                             returnGroupId = returnGroupId,
                                                             returnPageIndex = Model.CurrentPageIndex
                                                         }, new { @class = "dd-site" })
                                            </li>
                                        }
                                        @if (canAssignPermission)
                                        {
                                            <li>
                                                @Html.ActionLink(string.Format("View Permission of '{0}'", item.Username), "AssignPermission",
                                                         new
                                                         {
                                                             id = item.UserId,
                                                             siteId = item.SiteId,
                                                             returnUserName = ViewBag.Username,
                                                             returnSiteId = item.SiteId,
                                                             returnGroupId = returnGroupId,
                                                             returnPageIndex = Model.CurrentPageIndex
                                                         }, new { @class = "dd-permission" })
                                            </li>
                                        }
                                        @if (canAssignSiteFunction)
                                        {
                                            <li>
                                                @Html.ActionLink(string.Format("View Site/Function of '{0}'", item.Username), "AssignSiteFunction",
                                                         new
                                                         {
                                                             id = item.UserId,
                                                             returnUserName = ViewBag.Username,
                                                             returnSiteId = item.SiteId,
                                                             returnGroupId = returnGroupId,
                                                             returnPageIndex = Model.CurrentPageIndex
                                                         }, new { @class = "dd-site" })
                                            </li>
                                        }
                                    </ul>
                                </div>

                            </div>
                        }
                    </td>


                </tr>

                i++;
            }
        }
        else
        {
            <tr class="no-info">
                <td colspan="12" class="text-center">
                    @ViewResources.NoInformationAvailable
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="12">
                @if (Model != null && Model.Count() > 0)
                {
                    <span class="items-per-page-wrp">
                        @ViewResources.PageSize
                        @Html.DropDownList("items-per-page", new List<SelectListItem> {
                    new() { Value = "10", Text = "10", Selected = "10" == Model.PageSize.ToString() },
                    new() { Value = "20", Text = "20", Selected = "20" == Model.PageSize.ToString() },
                    new() { Value = "50", Text = "50", Selected = "50" == Model.PageSize.ToString() },
                    new() { Value = "100", Text = "100", Selected = "100" == Model.PageSize.ToString() },
                    new() { Value = "200", Text = "200", Selected = "200" == Model.PageSize.ToString() }
                    }, new { id = string.Empty, @class = "items-per-page" })
                    </span>
                    <div id="jpages"></div>
                }
            </td>
        </tr>
    </tfoot>
</table>
@section Foot {
    <script src="~/scripts/User/Manage.js" type="text/javascript"></script>
    <script type="text/ecmascript">
        $(document).ready(function(){
            var totalItemCount = @Model.TotalItemCount;
            var pageSize = @Model.PageSize;
            var currentPage = @Model.CurrentPageIndex;
            $('#jpages').setupPagination(currentPage, pageSize, totalItemCount);
        });
    </script>
}