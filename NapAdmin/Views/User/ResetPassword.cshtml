@model NapAdmin.ViewModels.User.ResetPasswordVM
@{
    ViewBag.Title = ViewResources.Reset_Password;
    bool success = ViewBag.Success != null && ViewBag.Success;
}
@section Head {
    <link type="text/css" rel="stylesheet" href="~/themes/nap/style.css" />
}
@section Headline {
    <span class="title">
        <span class="first">@ViewResources.User_Management /</span>
        @ViewBag.Title
    </span>
    <div class="button-action">
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User",
                new
                {
                    userName = Model.ReturnData.ReturnUserName,
                    siteId = Model.ReturnData.ReturnSiteId,
                    groupId = Model.ReturnData.ReturnGroupId,
                    id = Model.ReturnData.ReturnPageIndex
                }, new { @class = "back-button" })
    </div>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "mainForm", @role = "form", @class = "form-horizontal col-sm-7 col-md-5 common-form" }))
{
    <div class="form-group summary">
        <div class="col-sm-3">
        </div>
        <div class="col-sm-8">
            @Html.ValidationSummary()
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-2 col-sm-4 lbl-field">
            <label>@ViewResources.Username</label>
        </div>
        <div class="col-xs-9 col-sm-7">
            <label class="pull-left">@Model.Criteria.Username</label>
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-4 lbl-field">@Html.LabelFor(c => c.Criteria.UserPwd)</div>
        <div class="col-xs-12 col-sm-7">
            @Html.PasswordFor(c => c.Criteria.UserPwd, new { id = "UserPwd", @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-4 lbl-field">@Html.LabelFor(c => c.Criteria.ConfirmUserPwd)</div>
        <div class="col-xs-12 col-sm-7">
            @Html.PasswordFor(c => c.Criteria.ConfirmUserPwd, new { id = "ConfirmUserPwd", @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-offset-4 col-xs-12 col-sm-7">
            @if (!success)
            {
                <input type="submit" value="@ViewResources.Save" />
                <button class="cancel-button" onclick="NAP.redirect('User/Manage/@Model.ReturnData.ReturnPageIndex?userName=@Model.ReturnData.ReturnUserName&siteId=@Model.ReturnData.ReturnSiteId&groupId=@Model.ReturnData.ReturnGroupId', 0); return false;">@ViewResources.Cancel</button>
            }
        </div>
    </div>
}
@* To keep the behavior of the form and not change the code to much, we will pass the encrypted passwords
    to a hidden form and submit it instead of the original one *@
@if (!success)
{
    <form id="hiddenForm" method="post" novalidate="novalidate">
        @Html.HiddenFor(c => c.Criteria.Token, new { id = "token" })
        @Html.HiddenFor(c => c.Criteria.Username, new { id = "username" })
        @Html.HiddenFor(c => c.Criteria.CustId, new { id = "custId" })
        @Html.HiddenFor(c => c.Criteria.UserPwd, new { id = "newPassword" })
        @Html.HiddenFor(c => c.Criteria.ConfirmUserPwd, new { id = "confirmPassword" })

        @Html.HiddenFor(f => f.ReturnData.ReturnUserName, new { id = "returnUserName" })
        @Html.HiddenFor(f => f.ReturnData.ReturnSiteId, new { id = "returnSiteId" })
        @Html.HiddenFor(f => f.ReturnData.ReturnGroupId, new { id = "returnGroupId" })
        @Html.HiddenFor(f => f.ReturnData.ReturnPageIndex, new { id = "returnPageIndex" })
    </form>
}
@section Foot
{
    <script src="~/scripts/lib/crypto/CryptoJS.js" type="text/ecmascript"></script>
    <script src="~/scripts/User/ResetPassword.js" type="text/ecmascript"></script>
    @if (success)
    {
        var dialogMsg = string.Format(ViewResources.ResetPwdSuccessMsg, Model.Criteria.Username, 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'User/Manage/@Model.ReturnData.ReturnPageIndex?userName=@Model.ReturnData.ReturnUserName&siteId=@Model.ReturnData.ReturnSiteId&groupId=@Model.ReturnData.ReturnGroupId', 4000);
            });
        </script>
    }
}