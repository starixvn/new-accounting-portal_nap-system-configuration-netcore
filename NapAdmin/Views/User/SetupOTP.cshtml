@using System.Collections
@model PagerList<SetupOTPItem>
@{
    ViewBag.Title = "Set up OTP";
    var hasEditRight = (bool)ViewBag.HasEditRight;
}
@section Head {
    <link type="text/css" rel="stylesheet" href="~/themes/nap/otp/manage.css" />
}
@section Headline {
    <span class="title">
        <span class="first">@ViewResources.User_Management /</span> @ViewBag.Title
    </span>
    <div class="button-action">
    </div>
}
<form method="get" action="@Url.Content("~/Admin/User/SetupOTP")" role="form" class="form-inline col-sm-12 filter-form">

    <div class="form-group">
        @Html.Label(ViewResources.Username)
        <input type="text" value="@(ViewBag.Username)" name="username" id="username" />
    </div>

    <div class="form-group" style="display:none">
        @Html.Label("System", "System")
        @Html.DropDownList("System", new List<SelectListItem> {
         new() { Text = "All", Value = "", Selected = true },
         new() { Text = "NAP", Value = "NAP"  },
         new() { Text = "NAP SC", Value = "NAP SC"  }
     })
    </div>
    <div class="form-group">
        @Html.Label("Status", "Status")
        @Html.DropDownList("Status", new List<SelectListItem> {
        new() { Text = "All", Value = "0"  },
        new() { Text = "Active", Value = "1" , Selected = true },
        new() { Text = "Closed", Value = "2"  }
    })
    </div>


    <div class="form-group">
        <input type="submit" value="@ViewResources.Submit" />
    </div>
</form>
<table class="col-sm-12 grid">
    <thead>
        <tr>
            <th class="first">
                #
            </th>
            <th>
                @ViewResources.Username
            </th>
            <th>
                System
            </th>
            <th>
                @ViewResources.First_Name
            </th>
            <th>
                @ViewResources.Creator
            </th>

            <th>
                @ViewResources.Status
            </th>
            <th>
                Ignore OTP
            </th>
            <th colspan="2">
                Generate Key
            </th>
        </tr>
    </thead>
    <tbody id="grid-user">
        @{ var i = 0;}
        @foreach (var item in Model)
        {
            var rowCss = i % 2 == 0 ? string.Empty : "class='alt'";

            <tr @Html.Raw(rowCss)>
                <td class="text-center">
                    @((i + 1) + ((Model.CurrentPageIndex - 1) * Model.PageSize))
                </td>
                <td>
                    @item.Username
                </td>
                <td>
                    @item.System
                </td>
                <td>
                    @item.Firstname
                </td>

                <td>
                    @item.CreatorName
                </td>
                <td class="text-center">
                    <div class="@(item.Status != "Active" ? "text-danger": string.Empty)">
                        @item.Status
                    </div>
                </td>
                <td class="text-center">
                    @if (hasEditRight)
                    {
                        var activateText = item.IgnoreOTP ? "Apply OTP" : "Ignore OTP";

                        @Html.CheckBox(string.Format("chk-ignore-otp-{0}", item.CustId), item.IgnoreOTP,
                            new
                            {
                                data_cust_id = item.CustId,
                                data_system = item.System,
                                @class = "ignore-otp",
                                title = activateText
                            })
                    }
                    else if (item.IgnoreOTP)
                    {
                        <img src="~/themes/nap/img/blank.png" alt="" class="ico-tick" />
                    }
                </td>
                <td class="text-center">
                    @{var icoGenerateClass = hasEditRight ? "ico-generate-normal" : "ico-generate-disabled"; }
                    <span id="secret-key-@item.CustId"
                          class="ico-action @icoGenerateClass"
                          title="Generate key"
                          data-cust-id="@item.CustId"
                          data-system="@item.System"
                          data-secret-key="@item.SecretKey"></span>
                </td>
                <td class="text-center">
                    @{var icoCopyClass = !string.IsNullOrEmpty(item.SecretKey) ? "ico-copy-normal" : "ico-copy-disabled"; }
                    <span class="ico-action  @icoCopyClass"
                          title="Copy key"
                          id="copy-key-@item.CustId"
                          data-cust-id="@item.CustId"></span>
                </td>
            </tr>

            i++;
        }


        @if (Model.Count() == 0)
        {
            <tr class="no-info">
                <td colspan="9" class="text-center">
                    @ViewResources.NoInformationAvailable
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="9">
                @if (Model != null && Model.Count() > 0)
                {
                    <span class="items-per-page-wrp">
                        @ViewResources.PageSize
                        @Html.DropDownList("items-per-page", new List<SelectListItem> {
                            new() { Value = "10", Text = "10", Selected = "10" == Model.PageSize.ToString() },
                            new() { Value = "20", Text = "20", Selected = "20" == Model.PageSize.ToString() },
                            new() { Value = "30", Text = "30", Selected = "30" == Model.PageSize.ToString() }
                        }, new { id = string.Empty, @class = "items-per-page" })
                    </span>
                   @* @Html.Pager(Model.TotalItemCount, Model.PageSize, Model.CurrentPageIndex, new PagerOptions()
               {
                   PageIndexParameterName = "id",
                   ShowFirstLast = true,
                   ShowPrevNext = true,
                   ShowDisabledPagerItems = true,
                   ShowMorePagerItems = true,
                   NumericPagerItemCount = 20,
                   CurrentPagerItemTemplate = "<a disabled='disabled'>{0}</a>",
                   CssClass = "jpages"
               })*@
                }
            </td>
        </tr>
    </tfoot>
</table>
@section Foot {
    <script src="~/scripts/User/SetupOTP.js" type="text/javascript"></script>
}