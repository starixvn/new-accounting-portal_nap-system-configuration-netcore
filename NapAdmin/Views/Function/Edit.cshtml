
@model UpdateFunctionCriteria
@{
    ViewBag.Title = ViewResources.Update_Function;
    bool success = ViewBag.Success != null && ViewBag.Success;

    var viewFlags = (ViewFlags)ViewBag.ViewFlags;
}
@section Head {
    <link type="text/css" rel="stylesheet" href="~/themes/nap/function/edit.css" />
}
@section Headline {
    <span class="title">
		<span class="first">@ViewResources.Function @ViewResources.Management /</span> @ViewBag.Title
    </span>
    <div class="button-action">
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Function", new { siteId = Model.SiteId }, new { @class = "back-button" })
    </div>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-sm-7 col-md-5 common-form" }))
{
    @Html.HiddenFor(m => m.FunctionId, Model.FunctionId)
    <div class="form-group">
        <div id="error">
            @Html.ValidationSummary()
        </div>
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.FunctionName, ViewResources.Function_Name)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(m => m.FunctionName, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.FunctionKey, ViewResources.Function_Key)
        </div>
        <div class="col-xs-10 col-sm-8">
            @Html.TextBox("txtFunctionKey", Model.FunctionKey, new { disabled = "disabled", @class = "form-control" })
            @Html.HiddenFor(m => m.FunctionKey)
        </div>
        <div class="col-xs-2 col-sm-1 lbl-field icon-edit">
            <a id="lbtn-edit-funckey" href="javascript:;" class="btn-edit" title="@ViewResources.Edit @ViewResources.Function_Key">
            </a>
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.SiteId, ViewResources.Site)
        </div>
        <div class="col-xs-12 col-sm-8 rdo-field">
            @Html.Label(Model.SiteName)
            @Html.HiddenFor(m => m.SiteId, Model.SiteId)
            @Html.HiddenFor(m => m.SiteName, Model.SiteName)
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.Description)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.Readonly)
        </div>
        <div class="col-xs-12 col-sm-8 rdo-field">
            @Html.CheckBoxFor(m => m.Readonly)
        </div>
    </div>
    if (viewFlags.IsLive)
    {
    @Html.HiddenFor(m => m.Environment)
    }
    else
    {
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.Environment)
        </div>
        <div class="col-xs-12 col-sm-8 rdo-field">
            @Html.RadioButtonFor(m => m.Environment, "UAT", new { id = "Environment-UAT" })
            @Html.Label("Environment-UAT", ViewResources.UAT)
            @Html.RadioButtonFor(m => m.Environment, "LIVE", new { id = "Environment-LIVE" })
            @Html.Label("Environment-LIVE", ViewResources.LIVE)
        </div>
    </div>
    }
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.ParentId, ViewResources.Parent)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.DropDownListFor(m => m.ParentId, (List<SelectListItem>)ViewBag.ParentFunctionItemList, ViewResources.None, new { @class = "form-control" })
            @Html.HiddenFor(m => m.ParentName)
        </div>
    </div>
    <div class="form-group required">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.DisplayOrder, ViewResources.Display_Order)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.IsActive, ViewResources.Status)
        </div>
        <div class="col-xs-12 col-sm-8 chk-field">
            @Html.CheckBoxFor(m => m.IsActive, new { @class = "chkActive" })
            @Html.LabelFor(m => m.IsActive, ViewResources.Active)
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
        </div>
        <div class="col-xs-12 col-sm-8">
            @if (!success)
            {
                <input type="submit" value="@ViewResources.Save" />
                <button class="cancel-button" onclick="NAP.redirect('Function/Manage?siteId=@Model.SiteId', 0); return false;">@ViewResources.Cancel</button>
            }
        </div>
    </div>
}
@section Foot {
    <script type="text/javascript">
        $(function () {
            $('input[type=reset]').bind('click', function () {
                window.location.replace(NAP.resolveClientUrl('Function/Manage?siteId=@Model.SiteId'));
            });
        });
    </script>
    <script src="~/scripts/Function/Edit.js" type="text/javascript"></script>
    <script src="~/scripts/lib/jquery.numeric-1.3.js" type="text/javascript"></script>
	<script src="~/scripts/lib/jsrender.js" type="text/javascript"></script>
    <script type="text/x-jsrender" id="DropdownListTpl">
        <option value="{{:id}}">{{:name}}</option>
    </script>
    @if (success)
    {
        var dialogMsg = string.Format(ViewResources.EditSuccessMsg, 
			ViewResources.Function + " '" + Model.FunctionName + "'", 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'Function/Manage?siteId=@Model.SiteId', 4000);
            });
        </script>
    }
}