@using Fanex.NAP.Core.Criteria.Function
@using Fanex.NAP.Core.Business
@model DuplicateFunctionCriteria
@{
    ViewBag.Title = ViewResources.Duplicate_Function;
    bool success = ViewBag.Success != null && ViewBag.Success;

    var viewFlags = (ViewFlags)ViewBag.ViewFlags;
}
@section Head {
    @Styles.Render("~/Areas/UserControl/themes/BasicStyles")
}
@section Headline {
    <span class="title">
        <span class="first">@ViewResources.Function @ViewResources.Management /</span>
        @string.Format("Duplicate '{0}' Function", ViewBag.OriginFunctionName)
    </span>
    <div class="button-action">
    @if (Model.ReturnSiteId == null)
    { 
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Function", null, new { @class = "back-button" })
    }
    else
    {
        @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Function", new { siteId = Model.ReturnSiteId },
                        new { @class = "back-button" })
    }
    </div>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-sm-7 col-md-5 common-form" }))
{
        <div class="form-group auto-min-height">
            @Html.ValidationSummary()
        </div>
        <div class="form-group required">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(m => m.FunctionName, ViewResources.Function_Name)
            </div>
            <div class="col-xs-12 col-sm-8">
                @Html.Hidden("FunctionId", Model.FunctionId)
                @Html.TextBoxFor(m => m.FunctionName, new {@class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-2 col-sm-3 lbl-field">
                <label>@ViewResources.Site</label>
            </div>
            <div class="col-xs-9 col-sm-8 rdo-field">
                <label class="read-only">@Model.SiteName</label>
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(m => m.Description)
            </div>
            <div class="col-xs-12 col-sm-8">
                @Html.TextBoxFor(m => m.Description, new { @class = "form-control"})
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(m => m.Readonly)
            </div>
            <div class="col-xs-12 col-sm-8 rdo-field">
                @Html.CheckBoxFor(m => m.Readonly, new { disabled = "disabled" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(m => m.ParentId, ViewResources.Parent)
            </div>
            <div class="col-xs-12 col-sm-8">
                @Html.DropDownListFor(m => m.ParentId, (List<SelectListItem>)ViewBag.FunctionList, ViewResources.None, new { @class = "form-control"})
                @Html.HiddenFor(m => m.ParentName)
            </div>
        </div>
        <div class="form-group required">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(m => m.DisplayOrder, ViewResources.Display_Order)
            </div>
            <div class="col-xs-12 col-sm-8">
                @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control"})
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(m => m.IsActive, ViewResources.Status)
            </div>
            <div class="col-xs-12 col-sm-8 chk-field">
                @Html.CheckBoxFor(m => m.IsActive, new {@class = "chkActive" })
                @Html.LabelFor(m => m.IsActive, ViewResources.Active)
            </div>
        </div>
        if (viewFlags.IsLive)
        {
            @Html.HiddenFor(m => m.Environment)
        }
        else
        {
            <div class="form-group">
                <div class="col-xs-12 col-sm-3 lbl-field">
                    @Html.LabelFor(m => m.Environment)
                </div>
                <div class="col-xs-12 col-sm-8 rdo-field">
                    @Html.RadioButtonFor(m => m.Environment, "UAT", new { id = "Environment-UAT" })
                    @Html.Label("Environment-UAT", ViewResources.UAT)
                    @Html.RadioButtonFor(m => m.Environment, "LIVE", new { id = "Environment-LIVE" })
                    @Html.Label("Environment-LIVE", ViewResources.LIVE)
                </div>
            </div>
        }
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field"></div>
            <div class="col-xs-12 col-sm-8">
                @if (!success)
                {
                    <input type="submit" value="@ViewResources.Save" />
                    <button class="cancel-button" onclick="NAP.redirect('Function/Manage?siteId=@Model.ReturnSiteId', 0); return false;">@ViewResources.Cancel</button>
                }
            </div>
        </div>
    @Html.HiddenFor(m => m.ReturnSiteId)
}
@section Foot {
    <script src="~/Areas/UserControl/scripts/Function/Duplicate.js" type="text/javascript"></script>
    @if (success)
    {
        string dialogMsg = string.Format(ViewResources.AddSuccessMsg, ViewResources.Function + " '" + Model.FunctionName + "'", 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'Function/Manage?siteId=@Model.ReturnSiteId', 4000);
            });
        </script>
    }
}