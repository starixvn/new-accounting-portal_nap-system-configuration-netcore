
@model CopyPermissionCriteria
@{
    ViewBag.Title = ViewResources.Copy_Permission;
    bool success = ViewBag.Success != null && ViewBag.Success;

    var viewFlags = (ViewFlags)ViewBag.ViewFlags;
}
@section Head {
    <link type="text/css" rel="stylesheet" href="~/themes/nap/style.css" />
}
@section Headline {
    <span class="title">
        <span class="first">@ViewResources.Function @ViewResources.Management /</span> Copy permission
    </span>
    <div class="button-action">
        @if (Model.ReturnSiteId == 0)
        {
            @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Function", null, new { @class = "back-button" })
        }
        else
        {
            @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Function", new { siteId = Model.ReturnSiteId },
                            new { @class = "back-button" })
        }
    </div>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-sm-7 col-md-5 common-form" }))
{
    <div class="form-group auto-min-height">
        @Html.ValidationSummary()
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.FromFunctionId, ViewResources.From + " " + ViewResources.Function)
        </div>
        <div class="col-xs-12 col-sm-8">
            @Html.DropDownListFor(m => m.FromFunctionId, (List<SelectListItem>)ViewBag.FunctionList, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field">
            @Html.LabelFor(m => m.ToFunctionId, ViewResources.To + " " + ViewResources.Function)
        </div>
        <div class="col-xs-12 col-sm-8 rdo-field">
            @Html.Label(Model.ToFunctionName)
            @Html.HiddenFor(m => m.ToFunctionId, Model.ToFunctionId)
            @Html.HiddenFor(m => m.ToFunctionName, Model.ToFunctionName)
        </div>
    </div>
    @Html.HiddenFor(m => m.SiteId, Model.SiteId)
    <div class="form-group">
        <div class="col-xs-12 col-sm-3 lbl-field"></div>
        <div class="col-xs-12 col-sm-8">
            @if (!success)
            {
                <input type="submit" value="@ViewResources.Save" />
                <button class="cancel-button" onclick="NAP.redirect('Function/Manage?siteId=@Model.ReturnSiteId', 0); return false;">@ViewResources.Cancel</button>
            }
        </div>
    </div>
    @Html.HiddenFor(m => m.ReturnSiteId)
}
@section Foot {
    <script src="~/scripts/Function/Duplicate.js" type="text/javascript"></script>
    @if (success)
    {
        var dialogMsg = string.Format(ViewResources.CopyPermissionSuccessMsg, ViewResources.Function + " '" + Model.ToFunctionName + "'", 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'Function/Manage?siteId=@Model.ReturnSiteId', 4000);
            });
        </script>
    }
}