@model PagerList<UserLevel>
@{
    Layout = null;
    var viewFlags = (ViewFlags)ViewBag.ViewFlags;
}
<table class="grid">
    <thead>
        <tr>
            <th class="first">
                <input type="checkbox" />
            </th>
            <th>
                @ViewResources.Username
            </th>
            <th>
                @ViewResources.First_Name
            </th>
            <th>
                @ViewResources.Last_Name
            </th>
            <th>
                @ViewResources.Email
            </th>
            <th>
                @ViewResources.Group
            </th>
            <th>
                @ViewResources.Level
            </th>
            <th>
                @ViewResources.Active
            </th>
            <th>
                @ViewResources.Policy
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!ReferenceEquals(Model, null) && Model.Any())
        {
            var i = 0;
            foreach (var item in Model)
            {
                var rowCss = i % 2 == 0 ? string.Empty : "class='alt'";

                <tr @Html.Raw(rowCss)>
                    <td class="text-center">
                        <input type="checkbox" uid="@item.UserId" />
                    </td>
                    <td>
                        @item.Username
                    </td>
                    <td>
                        @item.FirstName
                    </td>
                    <td>
                        @item.LastName
                    </td>
                    <td>
                        @item.Email
                    </td>
                    <td>
                        @item.GroupName
                    </td>
                    <td class="text-center">
                        @item.Level.ToUserLevel()
                    </td>
                    <td class="text-center">
                        @if (item.IsActive)
                        {
                            <img src="~/themes/nap/img/blank.png" width="16" height="15" alt="" class="ico-tick" />
                        }
                    </td>
                    <td>
                        @if (ViewBag.IsReadonlyAssign)
                        {
                            @ViewResources.Readonly
                        }
                        else
                        {
                            <input type="radio" name="rdo-policy-@item.UserId" id="rdo-read-@item.UserId" checked="checked" />
                            <label for="rdo-read-@item.UserId">@ViewResources.Read</label>
                            <input type="radio" name="rdo-policy-@item.UserId" id="rdo-host-@item.UserId" />
                            <label for="rdo-host-@item.UserId">@ViewResources.Host</label>
                        }
                    </td>
                </tr>
                i++;
            }
        }
        else
        {
            <tr class="no-info">
                <td colspan="10" class="text-center">
                    @ViewResources.NoInformationAvailable
                </td>
            </tr>
        }
    </tbody>
</table>
@if (!ReferenceEquals(Model, null) && Model.Count() > 0)
{
    <div class="button-list">
        <input type="submit" value="@ViewResources.Add_Selected_Users" disabled="disabled" />
    </div>
}