@{
    var newLog = ViewBag.NewLog as SiteLevel;
}

@if (newLog != null)
{
    <h1>@ViewResources.Site @ViewResources.New_Value</h1>
    <br />
    <table class="grid">
        <thead>
                <tr>
                    <th>
                        @ViewResources.Site_Name
                    </th>
                    <th>
                        @ViewResources.Level
                    </th>
                    <th>
                        @ViewResources.Active
                    </th>
                </tr>
        </thead>
        <tbody>
            <tr>
                <td>@newLog.SiteName</td>
                <td class="text-center">@newLog.Level.ToUserLevel()</td>
                <td class="text-center">
                        @if (newLog.IsActive)
                        {
                            <img class="ico-tick" alt="" src="~/themes/nap/img/blank.png">
                        }
                </td>
            </tr>
        </tbody>
    </table>
}