@model GetAllLogFunctionCriteria
@{
    ViewBag.Title = ViewResources.Log_Management;
    var listLog = (PagerList<LogFunction>)ViewBag.ListLog;
}
@section Head {
    <link type="text/css" rel="stylesheet" href="~/themes/nap/trace/logexecsp.css" />
}
@section Headline {
        <span class="title"><span class="first">@ViewResources.Log_Management / </span>@ViewResources.User_Function_Log</span>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-inline col-sm-12 filter-form" }))
{
    <div class="form-group">
        @Html.LabelFor(m => m.Name)
        @Html.TextBoxFor(m => m.Name)
    </div>
    <div class="form-group datetime">
        @Html.LabelFor(m => m.From)
        @Html.EditorFor(m => m.From)
    </div>
    <div class="form-group datetime">
        @Html.LabelFor(m => m.To)
        @Html.EditorFor(m => m.To)
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.SiteId)
        @Html.DropDownListFor(m => m.SiteId, (List<SelectListItem>)ViewBag.ListSite)
    </div>
    <div class="form-group">
        <input type="submit" value="@ViewResources.Submit" />
    </div>
    @Html.HiddenFor(m => m.PageIndex)   
    @Html.HiddenFor(m => m.PageSize)   
}
<table class="col-sm-12 grid">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @ViewResources.Log_ID
            </th>
            <th>
                @ViewResources.Log_Date
            </th>
            <th>
                @ViewResources.Function_Name
            </th>
            <th>
                @ViewResources.User
            </th>
            <th>
                @ViewResources.Site
            </th>
            <th>
                @ViewResources.Browser_Name
            </th>
            <th>
                @ViewResources.Param
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!ReferenceEquals(listLog, null) && listLog.Count() > 0)
        {
            var i = 0;
            foreach (var item in listLog)
            {
                var rowCss = i % 2 == 0 ? string.Empty : "class='alt'";

            <tr @Html.Raw(rowCss)>
                <td class="text-center">
                    @((i + 1) + ((Model.PageIndex - 1) * Model.PageSize))
                </td>
                <td>
                    @item.Id
                </td>
                <td style="width: 150px" class="text-center">
                    @item.LogDate.ToFullDateString()
                </td>
                <td>
                    @item.Function.Name
                </td>
                <td style="width: 200px">
                    @item.User.Username
                </td>
                <td style="width: 200px">
                    @item.Site.Name
                </td>
                <td>
                    @item.BrowserName
                </td>
                <td>
                    @item.Params
                </td>
            </tr>
                i++;
            }
        }
        else
        {
            <tr class="no-info">
                <td colspan="12" class="text-center">
                    @ViewResources.NoInformationAvailable
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="12">
                @if (listLog != null && listLog.Count() > 0)
                {
                    <span class="items-per-page-wrp">@ViewResources.PageSize
                        @Html.DropDownList("items-per-page", new List<SelectListItem>
                        { new()
                        { Value = "10", Text = "10", Selected = "10" == Model.PageSize.ToString()
                        }, new()
                        { Value = "20", Text = "20", Selected = "20" == Model.PageSize.ToString()
                        }, new()
                        { Value = "30", Text = "30", Selected = "30" == Model.PageSize.ToString()
                        } }, new { id = string.Empty, @class = "items-per-page" })</span>
@*
                    @Html.Pager(listLog, new PagerOptions()
               {
                   PageIndexParameterName = "id",
                   ShowFirstLast = true,
                   ShowPrevNext = true,
                   ShowDisabledPagerItems = true,
                   ShowMorePagerItems = true,
                   NumericPagerItemCount = 20,
                   CurrentPagerItemTemplate = "<a disabled='disabled'>{0}</a>",
                   CssClass = "jpages"
               })*@
                }
            </td>
        </tr>
    </tfoot>
</table>
@Html.Hidden("imagePath", (string)@Url.Content("~/themes/img/smoothness/icon-calendar.png"))
@section Foot {
    <script src="~/scripts/Trace/LogUserLogin.js" type="text/javascript"></script>
}