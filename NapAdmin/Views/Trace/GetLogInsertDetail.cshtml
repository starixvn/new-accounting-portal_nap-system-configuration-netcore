@{
    Layout = null;
}
@model LogExecSp
@if (!ReferenceEquals(Model, null))
{
    if (Model.ActionId == (int)LogAction.NAP_Cust_Insert)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPCustInsert", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_User_Insert)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPUserInsert", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_Function_Insert)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPFunctionInsert", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_Group_Insert)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPGroupInsert", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_MenuItem_Insert)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPMenuItemInsert", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_Site_InsertWithSiteURL)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPSiteInsertWithSiteUrl", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_MenuItem_Update)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPMenuItemUpdate", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_MenuItem_UpdateStatus)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPMenuItemUpdateStatus", Model);
    }

    if (Model.ActionId is (int)LogAction.NAP_Function_Update or (int)LogAction.NAP_Function_Duplicate)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPFunctionUpdate", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_Function_UpdateStatus)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPFunctionUpdateStatus", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_Site_Update)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPSiteUpdate", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_Site_UpdateStatus)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPSiteUpdateStatus", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_Group_Update)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPGroupUpdate", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_Group_UpdateStatus)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPGroupUpdateStatus", Model);
    }

    if (Model.ActionId == (int)LogAction.NAP_Cust_Update)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPCustUpdate", Model);
    }

    if (Model.ActionId is (int)LogAction.NAP_Site_UpdateSiteURL or (int)LogAction.NAP_Site_InsertSiteURL or (int)LogAction.NAP_Site_UpdateDefaultSiteURL)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPSiteUrl", Model);
    }
    if (Model.ActionId is (int)LogAction.NAP_Group_AssignFunction or (int)LogAction.NAP_User_AssignFunction or (int)LogAction.NAP_Function_CopyPermission)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPAssignPermission", Model);
    }
    if (Model.ActionId == (int)LogAction.NAP_User_AssignNewSite)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPAssignNewSite", Model);
    }
    if (Model.ActionId == (int)LogAction.NAP_User_UpdateSite)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPUpdateSite", Model);
    }
    if (Model.ActionId == (int)LogAction.NAP_User_AssignSite)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPAssignSite", Model);
    }
    if (Model.ActionId == (int)LogAction.NAP_Function_AssignFunctionToUsers)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPFunctionAssignToUsers", Model);
    }
    if (Model.ActionId == (int)LogAction.NAP_Function_AssignFunctionToGroups)
    {
        await Html.PartialAsync("~/Views/Trace/_NAPFunctionAssignFunctionToGroups", Model);
    }
    if (Model.ActionId == (int)LogAction.Task_NAP_RevokeUserPermission)
    {
        await Html.PartialAsync("~/Views/Trace/_TaskNAPRevokeUserPermission", Model);
    }
}