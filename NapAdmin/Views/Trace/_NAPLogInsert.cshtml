@{
    Layout = null;
    var listData = (List<LogData>)ViewBag.LogData ?? [];
}
@model List<LogData>
<table class="grid">
    <thead>
        <tr>
            <th>
                @ViewResources.Field_Name
            </th>
            <th>
                @ViewResources.Value
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            var i = 0;
            foreach (var item in listData)
            {
                var rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
        
            <tr @Html.Raw(rowCss)>
                <td>@item.FieldName
                </td>
                <td>
                    @item.NewValue
                </td>
            </tr>
                i++;
            }
        }
    </tbody>
</table>