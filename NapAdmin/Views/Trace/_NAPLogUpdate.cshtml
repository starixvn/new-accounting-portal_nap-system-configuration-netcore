@{
    Layout = null;
    var listData = (List<LogData>)ViewBag.LogData ?? new List<LogData>();
}
@model List<LogData>
<table class="grid">
    <thead>
        <tr>
            <th>
                @ViewResources.Field_Name
            </th>
            <th>
                @ViewResources.Old_Value
            </th>
            <th>
                @ViewResources.New_Value
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            var i = 0;
            foreach (var item in listData)
            {
                var logStatusClass = item.OldValue != item.NewValue ? "log-status" : string.Empty;
                var rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
        
            <tr @Html.Raw(rowCss)>
                <td>
                    @item.FieldName
                </td>
                <td>
                    @item.OldValue
                </td>
                    <td class="@logStatusClass">
                    @item.NewValue
                </td>
            </tr>
                i++;
            }
        }
    </tbody>
</table>